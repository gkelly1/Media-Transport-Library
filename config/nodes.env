# SSH inventory - fill this in for your own cluster.
#
# Used only by the installer, preflight and helper scripts, which have to reach
# the hosts over SSH. Runtime Pod placement never uses this file; it uses the
# Kubernetes node names in config/lab.env.
#
# One entry per host, keyed by its Kubernetes node name:
#   <NODE NAME UPPERCASED, "-" REPLACED BY "_">_HOST=<hostname or IP>
# So a node named "worker-1" is configured as WORKER_1_HOST, and renaming the
# node in config/lab.env means renaming the key here too.
#
# Use the IP address each host is reachable at from the other hosts. A DNS name
# that resolves the same way everywhere works too, but a ~/.ssh/config alias does
# not: scripts/install-k8s-cluster.sh puts these values in every node's /etc/hosts
# and hands the controller's to kubeadm as the API server's advertise address,
# both of which need a real IP. Never use localhost or 127.0.0.1, not even for
# the host you are sitting on.
CONTROL_PLANE_HOST=134.191.216.6
WORKER_1_HOST=134.191.216.8

# Login used for every SSH connection this lab makes, unless a host sets its own
# below. It must exist on the control plane and on every worker that does not
# override it, must have passwordless SSH from the machine you drive the lab
# from, and must be able to run sudo on the workers (the host-side installers
# need root). A direct root login is also supported.
LAB_SSH_USER=gta

# Optional, per host: a login that differs from LAB_SSH_USER. Same key rule as
# _HOST, with _USER. Each host's sudo/root mode follows its own login.
#CONTROL_PLANE_USER=
#WORKER_1_USER=

# Optional, per worker: declared memory transfer rate in MT/s, used only when
# DMI is unreadable. Theoretical DRAM peak = populated channels x MT/s x 8
# bytes. A wrong value produces a wrong ceiling, so prefer
# scripts/install-platform-probe.sh, which lets a run read the real rate
# from DMI instead of trusting a hand-written number.
#WORKER_1_MEM_TRANSFER_MT_S=
