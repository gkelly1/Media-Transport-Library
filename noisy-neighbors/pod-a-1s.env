# Pod-A for a single-socket worker: ONE Guaranteed neighbor Pod, 5 exclusive cores.
# Same per-socket pressure as pod-a (light DRAM pressure, LLC-sized working set),
# but with a single Pod because there is no second socket to put one on.
#
# One Pod means the socket-split check does not apply, so
# NOISY_NEIGHBOR_REQUIRE_SOCKET_SPLIT is left unset. Do not use this profile on a
# two-socket worker: it would leave one socket quiet.
NOISY_NEIGHBOR_ARGS="--stream 4
--stream-l3-size 32M
--stream-index 0
--metrics-brief
--timeout 0
--log-file stress-ng.log"
NOISY_NEIGHBOR_SCOPE=pod
NOISY_NEIGHBOR_CPU_REQUEST=5
NOISY_NEIGHBOR_MEMORY_REQUEST=16Gi
NOISY_NEIGHBOR_MEMORY_LIMIT=16Gi
NOISY_NEIGHBOR_POD_COUNT=1
NOISY_NEIGHBOR_GUARANTEED=1
